generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id         String   @id @default(cuid())
  clerkOrgId String?  @unique @map("clerk_org_id")
  name       String
  slug       String   @unique
  domain     String?  @unique
  logoUrl    String?  @map("logo_url")
  logoData   Bytes?   @map("logo_data")
  logoMime   String?  @map("logo_mime")
  theme     String   @default("dark")
  mode      String   @default("dark")
  texture   String   @default("none")
  glow      String   @default("none")
  depth     String   @default("soft")
  rules     Json?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  apiKeys   ApiKey[]
  folders   Folder[]
  pages     Page[]
  members   OrgMember[]
  auditLogs AuditLog[]
  groups    Group[]

  @@map("organizations")
}

model OrgMember {
  id     String @id @default(cuid())
  orgId  String @map("org_id")
  userId String @map("user_id")
  // Display identity for auth modes whose userId is an opaque id (Clerk
  // user_...); backfilled lazily by the members API from the provider.
  email  String? @map("email")
  role   String @default("member")

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@map("org_members")
}

// Groups are a many-to-many primitive: users sit in multiple groups, groups
// have multiple members. v1 is the primitive only (CRUD + membership) — no
// wiring into folder approval rules, the review queue, or approvals yet.
model Group {
  id        String   @id @default(cuid())
  orgId     String   @map("org_id")
  name      String
  slug      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  org     Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  members GroupMember[]

  @@unique([orgId, slug])
  @@index([orgId])
  @@map("groups")
}

model GroupMember {
  id        String   @id @default(cuid())
  groupId   String   @map("group_id")
  userId    String   @map("user_id")
  role      String   @default("member")
  createdAt DateTime @default(now()) @map("created_at")

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([groupId])
  @@map("group_members")
}

model Folder {
  id         String   @id @default(cuid())
  orgId      String   @map("org_id")
  parentId   String?  @map("parent_id")
  name       String
  visibility String   @default("org")
  rules      Json?
  // UI-only badge for folders created by the seed script. Access control
  // is per-page via Page.seeded, not per-folder.
  locked     Boolean  @default(false)
  createdBy  String   @map("created_by")
  createdAt  DateTime @default(now()) @map("created_at")

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  parent   Folder?      @relation("FolderTree", fields: [parentId], references: [id])
  children Folder[]     @relation("FolderTree")
  pages    Page[]

  @@index([orgId])
  @@index([parentId])
  @@map("folders")
}

model Page {
  id         String    @id @default(cuid())
  orgId      String    @map("org_id")
  folderId   String?   @map("folder_id")
  slug       String
  title      String
  visibility String    @default("org")
  createdBy  String    @map("created_by")
  viewCount  Int       @default(0) @map("view_count")
  sortOrder  Int?      @map("sort_order")
  pinned     Boolean   @default(false)
  status           String    @default("active")
  dashboardEnabled Boolean   @default(false) @map("dashboard_enabled")
  supersededBy String? @map("superseded_by")
  // Estimated tokens (chars/4, same substrate as the knowledge graph) for the
  // latest version's yaml content. Null on pre-existing pages until the next
  // write or lazy backfill (see getBrainUsage in lib/pages.ts) fills it in.
  tokenCount   Int?    @map("token_count")
  rules        Json?
  lastViewedAt DateTime? @map("last_viewed_at")
  // npm dist-tag style trust pointer: a human marks one PageVersion as the
  // "trusted" read for agents. Null = no trusted version yet (no backfill).
  // Writes never touch this column — only markTrusted/clearTrusted do.
  trustedVersionId String? @map("trusted_version_id")
  seeded     Boolean   @default(false)
  pageType   String?   @map("page_type")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  org         Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  folder      Folder?       @relation(fields: [folderId], references: [id], onDelete: SetNull)
  versions    PageVersion[]
  annotations Annotation[]
  flags       PageFlag[]
  concepts    PageConcept[]
  linksFrom   PageLink[]    @relation("PageLinksFrom")
  linksTo     PageLink[]    @relation("PageLinksTo")
  shares      PageShare[]
  shareLinks  ShareLink[]

  @@unique([orgId, slug])
  @@index([orgId, visibility])
  @@map("pages")
}

model PageFlag {
  id           String    @id @default(cuid())
  pageId       String    @map("page_id")
  action       String
  reason       String
  evidence     String
  supersededBy String?   @map("superseded_by")
  confidence   String    @default("medium")
  actorId      String    @map("actor_id")
  status       String    @default("pending")
  snoozeUntil  DateTime? @map("snooze_until")
  resolvedBy   String?   @map("resolved_by")
  resolvedAt   DateTime? @map("resolved_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId])
  @@index([status])
  @@map("page_flags")
}

model PageVersion {
  id          String   @id @default(cuid())
  pageId      String   @map("page_id")
  yamlContent String   @map("yaml_content")
  jsonContent Json?    @map("json_content")
  contentHash String   @map("content_hash")
  createdBy   String   @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId])
  @@map("page_versions")
}

model Annotation {
  id          String   @id @default(cuid())
  pageId      String   @map("page_id")
  text        String
  author      String
  section     String?
  target      String?
  kind        String   @default("note")
  replacement String?
  status      String   @default("pending")
  source      String   @default("web")
  slide       String?
  visibility  String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId])
  @@index([pageId, status])
  @@map("annotations")
}

model ApiKey {
  id        String    @id @default(cuid())
  orgId     String    @map("org_id")
  name      String
  keyHash   String    @unique @map("key_hash")
  prefix    String
  scopes    String[]  @default(["read", "write"])
  createdBy String    @default("system") @map("created_by")
  createdAt DateTime  @default(now()) @map("created_at")
  revokedAt DateTime? @map("revoked_at")
  expiresAt DateTime? @map("expires_at")

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("api_keys")
}

model AuditLog {
  id           String   @id @default(cuid())
  orgId        String   @map("org_id")
  action       String
  resourceType String   @map("resource_type")
  resourceId   String   @map("resource_id")
  actorType    String   @default("user") @map("actor_type")
  actorId      String   @map("actor_id")
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at")

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([resourceType, resourceId])
  @@map("audit_logs")
}

model Concept {
  id             String   @id @default(cuid())
  normalizedName String   @unique @map("normalized_name")
  displayName    String   @map("display_name")
  kind           String   @default("")
  usageCount     Int      @default(1) @map("usage_count")
  // Recommended-tag bookkeeping: when isRecommended is true, orgId names the
  // org whose owner/admin picked this term as a suggested tag (see
  // lib/org-tags.ts) - this replaces the old org.rules "org-tags" JSON entry.
  // Concepts stay globally shared for page tagging regardless of this flag:
  // orgId/isRecommended only annotate who currently recommends the term, they
  // don't fence which org can attach it to a page. No FK to Organization on
  // purpose - a hard relation would cascade-delete a shared concept (still
  // used by other orgs' pages) when the recommending org is removed.
  orgId         String?  @map("org_id")
  isRecommended Boolean  @default(false) @map("is_recommended")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  pages PageConcept[]
  externalEdges ExternalEdge[]
  includesAsParent ConceptInclude[] @relation("IncludeParent")
  includesAsChild  ConceptInclude[] @relation("IncludeChild")
  verificationContexts ConceptVerificationContext[]

  @@index([orgId, isRecommended])
  @@map("concepts")
}

// A map (root or group) including another map as a sub-map: parent's tree
// pulls in child's dependents/external when rendered. Additive edge on the
// concept graph, org-scoped by convention (both concepts already carry
// their own org's pages) - not FK'd to org directly since Concept isn't
// either. Cycles are refused at write time (see includeMap in concepts.ts),
// never at read time, so a bad cycle can never make getDependents loop.
model ConceptInclude {
  id        String   @id @default(cuid())
  parentId  String   @map("parent_id")
  childId   String   @map("child_id")
  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  parent Concept @relation("IncludeParent", fields: [parentId], references: [id], onDelete: Cascade)
  child  Concept @relation("IncludeChild", fields: [childId], references: [id], onDelete: Cascade)

  @@unique([parentId, childId])
  @@index([childId])
  @@map("concept_includes")
}

// Per-context verification override for an edge (PageConcept or
// ExternalEdge) reached through an include chain. The edge's own
// verifiedAt/verifiedNote/needsChange columns are the record "for the
// concept this edge is tagged to" (its own context). This table holds the
// record "for a DIFFERENT root concept viewing it through an include" -
// verifying a shared leaf for one launch must never paint it verified for
// another launch that includes the same group. contextConceptId is that
// other root; absent = no override yet, read path treats it as never
// checked for that context rather than falling back to the base fields.
model ConceptVerificationContext {
  id               String    @id @default(cuid())
  edgeType         String    @map("edge_type") // "page" | "external"
  edgeId           String    @map("edge_id")   // PageConcept.id or ExternalEdge.id
  contextConceptId String    @map("context_concept_id")
  verifiedAt       DateTime  @map("verified_at")
  verifiedNote     String?   @map("verified_note")
  needsChange      Boolean   @default(false) @map("needs_change")
  createdBy        String    @map("created_by")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  contextConcept Concept @relation(fields: [contextConceptId], references: [id], onDelete: Cascade)

  @@unique([edgeType, edgeId, contextConceptId])
  @@index([contextConceptId])
  @@map("concept_verification_contexts")
}

model PageConcept {
  id        String   @id @default(cuid())
  pageId    String   @map("page_id")
  conceptId String   @map("concept_id")
  section   String   @default("")
  /// How the page relates to the concept: depends | asserts | references | instantiates.
  /// references is the untyped default; instantiates is system-written by create_from_template.
  rel       String   @default("references")
  /// Per-edge verification: when this page was last confirmed right *with
  /// respect to this concept*. A page that depends on pricing and on the
  /// tagline is checked for each separately. Any write to the page bumps
  /// every edge (writing is verifying); mark_verified bumps one. Null = never.
  verifiedAt   DateTime? @map("verified_at")
  verifiedNote String?   @map("verified_note")
  /// "Looked, and it is wrong": set by mark_verified status=needs_change,
  /// cleared by a write or a later holds.
  needsChange  Boolean   @default(false) @map("needs_change")
  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  page    Page    @relation(fields: [pageId], references: [id], onDelete: Cascade)
  concept Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@unique([pageId, conceptId, section])
  @@index([pageId])
  @@index([conceptId])
  @@map("page_concepts")
}

// An asset that lives outside curata (a deck in Drive, a README in GitHub).
// One row per normalized URL per org, so the same deck tracked against three
// concepts is one asset with three edges, not three assets with three states.
model ExternalAsset {
  id        String   @id @default(cuid())
  orgId     String   @map("org_id")
  url       String
  label     String
  owner     String?
  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  edges ExternalEdge[]

  @@unique([orgId, url])
  @@map("external_assets")
}

// asset --rel--> concept, with the same per-edge verification as PageConcept.
// Edge, not node: there is no page behind it, it hangs directly off the
// concept and shows inline in get_dependents next to the curata pages.
model ExternalEdge {
  id           String    @id @default(cuid())
  assetId      String    @map("asset_id")
  conceptId    String    @map("concept_id")
  rel          String    @default("depends")
  /// Null until someone actually checks the asset. Attaching is not checking.
  verifiedAt   DateTime? @map("verified_at")
  verifiedNote String?   @map("verified_note")
  needsChange  Boolean   @default(false) @map("needs_change")
  createdBy    String    @map("created_by")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  asset   ExternalAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  concept Concept       @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@unique([assetId, conceptId])
  @@index([conceptId])
  @@map("external_edges")
}

model PageLink {
  id          String   @id @default(cuid())
  fromPageId  String   @map("from_page_id")
  toPageId    String   @map("to_page_id")
  rel         String
  description String?
  createdBy   String   @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")

  fromPage Page @relation("PageLinksFrom", fields: [fromPageId], references: [id], onDelete: Cascade)
  toPage   Page @relation("PageLinksTo", fields: [toPageId], references: [id], onDelete: Cascade)

  @@unique([fromPageId, toPageId, rel])
  @@index([fromPageId])
  @@index([toPageId])
  @@map("page_links")
}

model PageShare {
  id        String   @id @default(cuid())
  pageId    String   @map("page_id")
  userId    String   @map("user_id")
  role      String   @default("viewer")
  invitedBy String   @map("invited_by")
  createdAt DateTime @default(now()) @map("created_at")

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, userId])
  @@index([userId])
  @@map("page_shares")
}

model ShareLink {
  id        String    @id @default(cuid())
  pageId    String    @map("page_id")
  token     String    @unique
  role      String    @default("viewer")
  expiresAt DateTime? @map("expires_at")
  createdBy String    @map("created_by")
  createdAt DateTime  @default(now()) @map("created_at")
  revokedAt DateTime? @map("revoked_at")

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId])
  @@map("share_links")
}
